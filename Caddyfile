{
    order cache before rate_limit
    # Order cache BEFORE encode so cache is the OUTER wrapper and encode the inner
    # one. On the response path inner handlers run first, so encode compresses the
    # body before cache stores it — Souin then caches the already-compressed bytes and
    # serves them straight from cache instead of re-compressing plaintext on every hit.
    # Without this, Caddy's default order puts encode outside cache and Souin would
    # store uncompressed pages. The @cacheable `key { headers Accept-Encoding }` below
    # keeps each encoding in its own entry so no client gets a mismatched body.
    order cache before encode

    # X-Site-Lang must be normalized BEFORE the cache handler runs, because the
    # cache key includes it (see the `key` block below). By default
    # request_header sits late in the middleware chain — after encode, and so
    # after cache given the ordering above — which would key every entry on a
    # header that had not been set yet.
    #
    # If a future Caddy version makes this ordering ambiguous, the guaranteed
    # alternative is to wrap the request_header lines, `cache` and
    # `reverse_proxy` in an explicit `route { }` block, which preserves written
    # order by definition. Validate with `caddy validate` after any change here.
    order request_header before cache

    cache {
        ttl 5m
        # Souin's default upstream deadline is shorter than a full-class working-set
        # search (e.g. "Search all" over ~790k ZefixOrganisation rows takes ~12s, and
        # a broad term can approach visoto's own 60s SPARQL timeout). Without this,
        # Souin gave up first and returned a bare-bodied 504 (DEADLINE-EXCEEDED) that
        # the frontend can't parse as JSON -> "Failed to load data". 65s keeps Souin
        # waiting just past visoto's 60s timeout so visoto is always the one to time
        # out, returning a proper JSON error envelope the table handles gracefully.
        timeout {
            backend 65s
        }
        api {
            souin {
            }
        }
    }
}

visoto.hutzli.org {
    # Souin's purge/admin API (/souin-api/*) is auto-mounted on this site by the
    # global cache.api block above. It's not meant for public use — restrict it
    # to internal Docker traffic (visoto's /api/cache/purge, over the
    # visoto-network bridge) and 403 anything from outside private IP ranges.
    @souinAdminExternal {
        path /souin-api/*
        not remote_ip private_ranges
    }
    respond @souinAdminExternal 403

    # ── Access log ───────────────────────────────────────────────────────────
    # Written as JSON to a shared volume (caddy_logs) and parsed by the goaccess
    # service into the dashboard served at /goaccess/ below.
    #
    # Rotation is not optional: without roll_size the volume grows unbounded.
    # GoAccess's --persist/--restore (docker-compose.yml) is what keeps a roll
    # from resetting the visitor totals to zero.
    #
    # Caddy's json format writes `ts` as a Unix epoch float, which is why the
    # goaccess service passes --date-format=%s --time-format=%s. That coupling
    # is guarded by scripts/test-goaccess-format.sh — run it if the dashboard
    # ever looks empty, because a mismatch fails silently (0 lines parsed, no
    # error, empty report).
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    # ── UI language normalization ────────────────────────────────────────────
    # Collapse the two language signals a browser sends (the site-lang cookie and
    # Accept-Language) into one header with a small, closed value set, so both
    # the cache key and the origin see a single normalized input.
    #
    # This list must match `languages` in visoto.config. Drift is safe but not
    # silent-correct: visoto re-validates X-Site-Lang against its own configured
    # set, so a code listed only here falls back to default_language.
    #
    # Why not vary on Accept-Language directly: its value space is effectively
    # unbounded ("de-CH,de;q=0.9,en-US;q=0.8,en;q=0.7" and endless variants), so
    # keying the cache on it fragmented entries per browser profile. X-Site-Lang
    # has at most six values, so each page has at most six cached variants.
    map {http.request.header.Accept-Language} {al_lang} {
        ~^\s*de  de
        ~^\s*fr  fr
        ~^\s*it  it
        ~^\s*rm  rm
        default  en
    }
    # The cookie is the explicit user choice and outranks Accept-Language, so it
    # is resolved first and only falls back to {al_lang} when absent.
    #
    # Why one map rather than a base `request_header` refined by two matcher-
    # scoped ones: the conditional form silently stopped applying in production —
    # the unconditional line still ran (responses kept reporting
    # `Vary: X-Site-Lang`), but the cookie lines never did, so every request was
    # rendered from Accept-Language alone and the topbar picker appeared to do
    # nothing. A single map has no matcher ordering to get wrong, and it keeps
    # the one property that matters for safety: the field is always REPLACED
    # from a closed value set, so a client-supplied X-Site-Lang can never be
    # injected and the cache key space stays bounded.
    #
    # The empty cookie is a real choice ("no language"), distinct from having no
    # cookie at all, so it maps to the empty string rather than falling through.
    # That depends on Caddy setting a present-but-empty header rather than
    # omitting it. Verify with
    #   curl -sI -H 'Cookie: site-lang=' https://visoto.hutzli.org/about.html
    # and check the response says `Vary: X-Site-Lang`. If Caddy omits it, visoto
    # degrades gracefully: it falls through to the cookie, still renders the
    # no-language variant, and only reports Vary: Accept-Language.
    # One line per code rather than a capture group: a regexp capture would work
    # here, but enumerating the closed set needs no placeholder-expansion
    # semantics to be true, and the list has to be kept in sync with
    # visoto.config either way.
    map {http.request.header.Cookie} {site_lang} {
        ~(?:^|;\s*)site-lang=de(?:;|$)  de
        ~(?:^|;\s*)site-lang=fr(?:;|$)  fr
        ~(?:^|;\s*)site-lang=it(?:;|$)  it
        ~(?:^|;\s*)site-lang=en(?:;|$)  en
        ~(?:^|;\s*)site-lang=rm(?:;|$)  rm
        ~(?:^|;\s*)site-lang=(?:;|$)    ""
        default                          {al_lang}
    }
    request_header X-Site-Lang {site_lang}

    # Compress responses (zstd preferred, gzip fallback). Ordered inside `cache`
    # via the global `order cache before encode`, so Souin stores the compressed
    # body. Caddy's encode skips already-small and already-compressed payloads
    # (images, woff2, etc.) on its own.
    encode zstd gzip

    # Two cache tiers, because the two kinds of route learn their language
    # differently. Both resolve their endpoint from ?endpoint= only (never the
    # client-managed selectedEndpoint cookie, which uncached entry pages honor)
    # and never emit Set-Cookie, so neither needs cookie handling here.

    # Page tier. The language comes from the site-lang cookie, normalized into
    # X-Site-Lang above, so it must be part of the key.
    @cacheablePages {
        method GET
        path /resource
    }
    cache @cacheablePages {
        # The origin sends `public, max-age=0, must-revalidate, s-maxage=21600`.
        # max-age=0 forces *browsers* to revalidate — necessary because a browser
        # cannot see X-Site-Lang, so `Vary: X-Site-Lang` means nothing to its
        # private cache and a language switch would otherwise re-serve the old
        # language. s-maxage is what keeps that from also crippling Souin: a
        # shared cache prefers s-maxage, so it still serves 6h without touching
        # the origin, and answers the browsers' revalidations itself with a 304.
        #
        # After deploying, confirm that is actually what happens: a second
        # request for the same URL should report a Souin cache hit rather than
        # re-running the SPARQL query. If Souin revalidates on every read
        # regardless, drop s-maxage here and rewrite Cache-Control for the shared
        # tier instead.
        ttl 6h
        # Fold the headers that legitimately vary the response body into the cache
        # key: Accept-Encoding because Souin stores the compressed bytes (see
        # `order cache before encode`), and X-Site-Lang because the whole UI is
        # rendered per language (the origin sends `Vary: X-Site-Lang`, but keying
        # explicitly keeps entries separated regardless of Vary handling).
        #
        # X-Site-Lang replaced Accept-Language here: it is set above from the
        # cookie and Accept-Language combined, and normalized to at most six
        # values, so it captures strictly more of what varies the response while
        # fragmenting the cache far less.
        key {
            headers Accept-Encoding X-Site-Lang
        }
    }

    # API tier. The fragment routes take BOTH identities from the URL — the
    # endpoint as ?endpoint= and the language as ?lang= (see resolveQueryLang in
    # cmd/visoto/main.go) — so the response is a complete function of the URL and
    # the origin sends no ETag and no Vary. Those responses carry
    # `public, max-age=21600, s-maxage=21600`, which browsers and Souin both
    # serve from directly: no revalidation round-trip at all.
    #
    # Keying on X-Site-Lang here would be strictly harmful: it would split one URL
    # into up to six identical entries. The language is already in the URL.
    #
    # The matcher is deliberately broad, so API routes added later are covered
    # without editing it. That is safe because the ORIGIN's Cache-Control decides
    # what Souin actually stores, not this matcher — it only grants eligibility.
    # The non-URL-pure GET routes it sweeps in (/api/monitoring/*,
    # /api/named-graphs, /api/ontologies, /api/export-graphs) never call
    # markCacheable, so they keep sending `max-age=0, must-revalidate` with an
    # ETag and are not stored for a TTL. POST/DELETE never match.
    #
    # /api/faceted-table/* is the one route here whose body depends on a request
    # header (Accept picks JSON vs HTML); it declares `Vary: Accept` itself.
    @cacheableApi {
        method GET
        path /api/*
    }
    cache @cacheableApi {
        ttl 6h
        key {
            headers Accept-Encoding
        }
    }

    # ── Analytics dashboard ──────────────────────────────────────────────────
    # The static report written by the goaccess service. A `route` (not a bare
    # matcher) so this terminates the chain and never falls through to
    # reverse_proxy — visoto has no /goaccess route and would 404.
    #
    # Must stay ABOVE reverse_proxy. It is deliberately outside both cache tiers:
    # @cacheablePages matches `path /resource` and @cacheableApi matches
    # `path /api/*`, so neither covers /goaccess/* and Souin will not cache a
    # report that changes every 5 minutes.
    #
    # ⚠ CURRENTLY PUBLIC — NO AUTHENTICATION.
    # The report exposes top URLs, referrers, user agents and visitor IPs
    # (anonymized to /24 by --anonymize-ip in docker-compose.yml). Anyone who
    # knows the path can read it.
    #
    # An attempt to put this behind basic_auth was reverted on 2026-09-17.
    # `basic_auth` does NOT expand {env.*} placeholders: Caddy stores the literal
    # string "{env.GOACCESS_HASH}" as the password, then rejects it at
    # provisioning with "username and password are required" — a CONFIG-LOAD
    # error, so it crash-loops Caddy and takes the WHOLE SITE down, not just this
    # route. Verified with `caddy adapt`, which shows the placeholder unexpanded
    # in the adapted JSON. Do not retry the env-var approach; it cannot work.
    #
    # Since this repo is PUBLIC, a committed bcrypt hash is the only way to use
    # basic_auth here, and that puts a permanent offline-cracking target next to
    # the hostname it guards.
    #
    # The clean fix, when this matters: drop basic_auth and restrict by SOURCE —
    # `@external not remote_ip private_ranges` + `respond @external 403`, reached
    # over an SSH tunnel (docs/deployment.md, Option A). No credential anywhere.
    #
    # Keep this a `route`, not a `handle`. Caddy re-sorts directives by type and
    # `file_server` sorts BEFORE `respond` — including inside a `handle` block,
    # which re-sorts its nested directives too. Written as a handle, the
    # source-restricted form's 403 loses to file_server and the lockdown fails
    # OPEN while looking correct. `route` is the only construct preserving
    # written order.
    route /goaccess/* {
        # GoAccess's bundled JS calls eval() during App.initialize(), and embeds
        # its icon font as a data: URI. Under the site-wide CSP below, both are
        # blocked and the report dies on its loading screen showing
        # "No authentication provided." — a misleading message that has nothing
        # to do with auth: initialize() simply threw an EvalError first.
        #
        # This replaces the site CSP for this path ONLY. 'unsafe-eval' stays off
        # everywhere else; do not move these relaxations into the global header
        # block. The report is a static local file with no user input, so the
        # weaker policy has no bearing on the app itself.
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"

        uri strip_prefix /goaccess
        root * /srv/goaccess
        file_server
    }

    rate_limit {
        zone client_ip {
            # Only meter dynamic requests. Static assets (/static/*, favicon, robots)
            # are cheap and plentiful — the homepage alone pulls ~36 resource SVG icons
            # plus CSS/JS, so counting them let a single page load burn most of the
            # per-minute budget. Two loads in a minute (e.g. switching endpoints, which
            # does a full location.reload) then tripped the limit and Caddy 429'd the
            # trailing requests — visibly, the icons silently failed to render. Excluding
            # /static/* keeps the limiter focused on SPARQL/API abuse.
            match {
                not path /static/* /favicon.ico /robots.txt
            }
            key {remote_host}
            events 100
            window 1m
        }
    }

    reverse_proxy visoto:8060

    @static {
        path /static/* /favicon.ico /robots.txt
    }
    header @static Cache-Control "public, max-age=86400"

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://getbootstrap.com; style-src 'self' 'unsafe-inline' blob: https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://ld.admin.ch https://lindas.admin.ch https://int.lindas.admin.ch https://test.lindas.admin.ch https://lindas.cz-aws.net https://lindas.int.cz-aws.net https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://generativelanguage.googleapis.com"
    }
}
