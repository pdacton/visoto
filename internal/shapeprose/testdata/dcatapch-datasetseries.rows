[1, ["b", "bn1006802329503024288"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to a web page that provides access to the resource, its distributions and/or additional information. It is intended to point to a landing page at the original data provider, not to a page on a site of a third party, such as an aggregator. Inherited from dcat:Resource.", "en", ""]]
