[1, ["b", "bn1006802329503024299"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/rights"]]
[1, ["b", "bn1006802329503024299"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Warning"]]
[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "The legislation that mandates the creation or management of the Dataset Series. An ELI identifier SHOULD be used. The FedLex identifier SHOULD be used for the federal level. If there is no ELI or FedLex identifier, then the dct:relation property (see ) MUST be used to indicate the legal basis. For more information see DCAT-AP - LegalResource", "en", ""]]
[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or more dcatap:applicableLegislation (eli:LegalResource).", "en", ""]]
[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "applicable legislation", "en", ""]]
