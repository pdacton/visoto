[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://data.europa.eu/r5r/applicableLegislation"]]
[1, ["b", "bn1006802329503024300"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024301"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "The frequency at which the Dataset Series is updated. The frequency of a Dataset Series is not equal to the frequency of the dataset in the collection. The frequency of a Dataset Series is the pace at which new elements are added to the dataset series. Whereas the frequency of a Dataset ist the frequency (pace) at which the Dataset is updated. CV to be used: [[VOCAB-EU-FREQUENCY]].", "en", ""]]
[1, ["b", "bn1006802329503024301"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024301"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or one dct:accrualPeriodicity (dct:Frequency).", "en", ""]]
[1, ["b", "bn1006802329503024301"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024301"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "frequency", "en", ""]]
