[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to a geographical region that is covered by the Dataset Series. When spatial coverage is a dimension in the dataset series then the spatial coverage of each dataset in the collection should be part of the spatial coverage. In that case, an open ended value is recommended, e.g. CH or a broad bounding box covering the expected values. This property may be indicated using an IRI reference or may be encoded as an instance of dct:Location . CV to be used for IRI reference: LINDAS resources SHOULD be used. Whenever a particular location is not available as LINDAS resource, then the EU Vocabularies Named Authority Lists MAY be used: [[VOCAB-EU-CONTINENT]], [[VOCAB-EU-COUNTRY]], [[VOCAB-EU-PLACE]], if the location is not in one of the mentioned EU Vocabularies, then Geonames URIs MAY be used: [[GEONAMES]]. For the encoding as instance of dct:Location see the class Location ( DCAT-AP - 7.12 Location ).", "en", ""]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or more dct:spatial (dct:Location).", "en", ""]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "spatial/ geographic", "en", ""]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/spatial"]]
[1, ["b", "bn1006802329503024302"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "A temporal period that the Dataset Series covers. When temporal coverage is a dimension in the dataset series then the temporal coverage of each dataset in the collection should be part of the temporal coverage. In that case, an open ended value is recommended, e.g. after 2012.", "en", ""]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or more dct:temporal (dct:PeriodOfTime).", "en", ""]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "temporal coverage", "en", ""]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/temporal"]]
[1, ["b", "bn1006802329503024303"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "The status of the resource in the context of maturity lifecycle. CV to be used [[VOCAB-EU-STATUS]]. Vocabulary in human-readable form: Status . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or one adms:status (skos:Concept).", "en", ""]]
[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "status", "en", ""]]
