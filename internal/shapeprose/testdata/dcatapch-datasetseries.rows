[1, ["b", "bn1006802329503024276"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property contains contact information that can be used for sending comments about the resource. This property MUST contain an email address that is continuously monitored by the data publisher. If there are several contributors involved in the publication of the resource, the property can be used multiple times. Inherited from dcat:Resource.", "en", ""]]
