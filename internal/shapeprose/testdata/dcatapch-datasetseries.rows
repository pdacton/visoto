[1, ["b", "bn1006802329503024304"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "A description of the differences between this version and a previous version of the Dataset. This property can be repeated for parallel language versions of the version notes. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or more adms:versionNotes (rdfs:Literal).", "en", ""]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "version notes", "en", ""]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#Literal"]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://www.w3.org/ns/adms#versionNotes"]]
[1, ["b", "bn1006802329503024305"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024306"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property provides a link to a description of a relationship with another resource and it’s especially meant for relationships between resources. It replaces the property rdfs:seeAlso of DCAT-AP CH v1. See here for examples on how to use it: dcat:qualifiedRelation . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024306"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:DatasetSeries may have zero or more dcat:qualifiedRelation (dcat:Relationship).", "en", ""]]
[1, ["b", "bn1006802329503024306"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024306"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "qualified relation", "en", ""]]
[1, ["b", "bn1006802329503024306"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
