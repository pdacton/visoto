[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property provides a link to a description of a relationship with another resource and it’s especially meant for relationships between resources. It replaces the property rdfs:seeAlso of DCAT-AP CH v1. See here for examples on how to use it: dcat:qualifiedRelation . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dcat:qualifiedRelation (dcat:Relationship).", "en", ""]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "qualified relation", "en", ""]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://www.w3.org/ns/dcat#qualifiedRelation"]]
[1, ["b", "bn1006802329503024366"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "The version indicator (name or identifier) of a resource. DCAT does not prescribe how a version name / identifier should be specified, and refers for guidance to DWBP - Best Practice 7: Provide a version indicator . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or one dcat:version (rdfs:Literal).", "en", ""]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "version", "en", ""]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#Literal"]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://www.w3.org/ns/dcat#version"]]
[1, ["b", "bn1006802329503024367"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "Information regarding access or restrictions based on privacy, security, or other policies. Use this property exclusively for statements about access restrictions (e.g., privacy, security, or policy-related restrictions). The [[VOCAB-EU-ACCESS-RIGHT]] SHOULD be used. Adapt categories definitions as needed for specific use cases. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or one dct:accessRights (dct:RightsStatement).", "en", ""]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "access rights", "en", ""]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/accessRights"]]
[1, ["b", "bn1006802329503024368"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to an implementing rule or other specification. This property SHOULD be used to indicate the model, schema, ontology, view or profile that this representation of a resource conforms to. This is (generally) a complementary concern to the media-type or format. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:conformsTo (dct:Standard).", "en", ""]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "conforms to", "en", ""]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/conformsTo"]]
[1, ["b", "bn1006802329503024369"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "An entity responsible for producing the resource (provider of the technical components), organisation or company. Resources of type foaf:Agent are recommended as values for this property. If from the public sector, use the same CV as . For swiss companies, use the corresponding Zefix entry https://register.ld.admin.ch/zefix/company/122015 , you can find the EHRA-ID of organisations on http://zefix.ch . Fallback: We recommend using the correspondend entry in Wikidata as CV, it is straight forward to add a missing entity to Wikidata. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:creator (foaf:Agent).", "en", ""]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "creator", "en", ""]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/creator"]]
[1, ["b", "bn1006802329503024370"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "A related resource that is included either physically or logically in the described resource. For more information about the relationship between datasets and other resources see DCAT- 13.2 Relationships between datasets and other resources . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:hasPart (dcat:Resource (dcat:Catalog, dcat:Dataset, dcat:DataService, dcat:DatasetSeries)).", "en", ""]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "has part", "en", ""]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/hasPart"]]
[1, ["b", "bn1006802329503024371"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property is about a related resource, such as a publication, that references, cites, or otherwise points to the resource. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:isReferencedBy (IRI).", "en", ""]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "is referenced by", "en", ""]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/isReferencedBy"]]
[1, ["b", "bn1006802329503024372"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to a language of the resource. This property can be repeated if there are multiple languages in the resource. CV to be used: [[VOCAB-EU-LANGUAGE]] Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:language (dct:LinguisticSystem).", "en", ""]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "language", "en", ""]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/language"]]
[1, ["b", "bn1006802329503024373"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "A related resource. This property refers to a related resource where the relationship cannot be further specified as a dcat:qualifiedRelation . This may be additional material such as an article, example or documentation helpful in the context of the resource. The element can also be used to link to legal foundations that apply to the publication or usage of the resource. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more dct:relation (IRI).", "en", ""]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "related resource", "en", ""]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://purl.org/dc/terms/relation"]]
[1, ["b", "bn1006802329503024374"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "The policy expressing the rights associated with the resource if using the [ODRL] vocabulary. Information about rights expressed as an ODRL policy [ ODRL MODEL ] using the ODRL vocabulary [ VOCAB ODRL ] MAY be provided for the distribution. See also guidance at DCAT 3 - 9. License and rights statements . Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or one odrl:hasPolicy (odrl:Policy).", "en", ""]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "has policy", "en", ""]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#nodeKind"], ["u", "http://www.w3.org/ns/shacl#BlankNodeOrIRI"]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#path"], ["u", "http://www.w3.org/ns/odrl/2/hasPolicy"]]
[1, ["b", "bn1006802329503024375"], ["u", "http://www.w3.org/ns/shacl#severity"], ["u", "http://www.w3.org/ns/shacl#Violation"]]
[1, ["b", "bn1006802329503024376"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to a link to an Agent having some form of responsibility for the resource Used to link to an Agent where the nature of the relationship is known but does not match one of the standard [ DCTERMS ] properties ( dcterms:creator , dcterms:publisher ). Use dcat:hadRole on the prov:Attribution to capture the responsibility of the Agent with respect to the Resource. See DCAT 3 - 15.1 Relationships between datasets and agents for usage examples. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024376"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or more prov:qualifiedAttribution (prov:Attribution).", "en", ""]]
[1, ["b", "bn1006802329503024376"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024376"], ["u", "http://www.w3.org/ns/shacl#name"], ["l", "qualified attribution", "en", ""]]
