[1, ["b", "bn1006802329503024348"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property refers to a statement that specifies rights associated with the resource. In general this property is not needed, as long as you already provide dct:licence , dct:accessRights . Prioritize using dct:licence , dct:accessRights and for a link to a legal text dcat:applicableLegislation. Use dct:rights only for additional, specific rights information. When using dct:rights, we advise you to use the Open Data Rights Statement Vocabulary (ODRS) . To refer to a dct:RightStatement it is recommended to use an URI. Inherited from dcat:Resource.", "en", ""]]
[1, ["b", "bn1006802329503024348"], ["u", "http://www.w3.org/ns/shacl#maxCount"], ["l", "1", "", "http://www.w3.org/2001/XMLSchema#int"]]
[1, ["b", "bn1006802329503024348"], ["u", "http://www.w3.org/ns/shacl#message"], ["l", "dcat:Dataset may have zero or one dct:rights (dct:RightsStatement).", "en", ""]]
[1, ["b", "bn1006802329503024348"], ["u", "http://www.w3.org/ns/shacl#minCount"], ["l", "0", "", "http://www.w3.org/2001/XMLSchema#int"]]
