[1, ["b", "bn1006802329503024319"], ["u", "http://www.w3.org/ns/shacl#description"], ["l", "This property contains a free-text account of the resource. This property can be repeated for parallel language versions of the description (see ). On the user interface of data portals, the content of the element whose language corresponds to the display language selected by the user is displayed. Inherited from dcat:Resource.", "en", ""]]
