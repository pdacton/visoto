# This is the configuration file for the visoto application
# Copy this file to visoto.config and fill in your actual values

# application settings
[application]
port = 8060
sparqlEndpoint = "https://ld.admin.ch/query/"  # Default endpoint
timeout = 30 # timeout in seconds
gemini_api_key = "YOUR_GEMINI_API_KEY_HERE" # Get from: https://aistudio.google.com/app/apikey

# Used when the request expresses no usable preference. Must be one of the codes
# declared in the [[application.languages]] blocks below.
default_language = "en"

# Named SPARQL endpoints for the sidebar endpoint-switcher menu.
# Each endpoint can have:
#   name    — display label in the menu
#   url     — SPARQL endpoint URL
#   default — pre-selected on startup (at most one should be true)
#   monitor — enable health monitoring on the /monitoring dashboard
#   tag     — logical group label; exposed to templates as .EndpointTag so templates
#             can conditionally show endpoint-specific content (e.g. {{ if eq .EndpointTag "lindas" }})
#   slug    — unique, URL-safe identifier for this endpoint (must be unique across all
#             entries, unlike tag). Enables shareable links via ?endpoint=<slug>, which
#             overrides the selectedEndpoint cookie for that request and updates it to
#             match. Omit to leave an endpoint unreachable via the query param.

# UI languages offered by the topbar picker, in the order they are declared here.
#   code  — the value carried by the site-lang cookie and the X-Site-Lang header,
#           and the name of the locales/<code>.toml message catalog. Every
#           non-empty code needs that catalog, or startup fails. The empty string
#           is a legal member: it is the "no language" choice, which renders the
#           base (English) catalog.
#   label — the text the picker displays. Conventionally the language's own
#           endonym ("Deutsch", not "German"), so the list reads the same
#           whichever language the page is currently rendered in. It is a
#           literal, not a message key: one label per code, in every locale.
#
# In production the codes are duplicated in the Caddyfile, which normalizes the
# site-lang cookie and Accept-Language into a single X-Site-Lang header ahead of
# the shared cache. The backend re-validates that header against the list below,
# so a Caddyfile that drifts out of sync can only fall back to
# default_language — it can never select an unconfigured language.
[[application.languages]]
code = "de"
label = "Deutsch"

[[application.languages]]
code = "fr"
label = "Français"

[[application.languages]]
code = "it"
label = "Italiano"

[[application.languages]]
code = "en"
label = "English"

[[application.languages]]
code = "rm"
label = "Rumantsch"

[[application.languages]]
code = ""
label = "No language"

[[application.sparqlEndpoints]]
name = "LINDAS prod"
url = "https://ld.admin.ch/query/"
default = true
monitor = true
tag = "lindas"
slug = "lindas-prod"
# access_token = "YOUR_TOKEN_HERE"  # optional: Bearer token for write operations (Upload data feature)
# username = ""                      # alternative: basic auth (used only if access_token is absent)
# password = ""
# search_provider = "stardog"        # FTS backend: "stardog" (default), "graphdb", "fuseki", "sparql-query"

[[application.sparqlEndpoints]]
name = "LINDAS int"
url = "https://int.lindas.admin.ch/query/"
monitor = true
tag = "lindas"
slug = "lindas-int"

[[application.sparqlEndpoints]]
name = "LINDAS test"
url = "https://test.lindas.admin.ch/query/"
monitor = true
tag = "lindas"
slug = "lindas-test"

[[application.sparqlEndpoints]]
name = "LINDASnext prod"
url = "https://lindas.cz-aws.net/query/"
monitor = true
tag = "lindas"
slug = "lindasnext-prod"

[[application.sparqlEndpoints]]
name = "LINDASnext int"
url = "https://lindas.int.cz-aws.net/query/"
monitor = false
tag = "lindas"
slug = "lindasnext-int"

# GraphDB endpoint with Simple FTS (no Lucene connector required)
# [[application.sparqlEndpoints]]
# name = "GraphDB (local)"
# url = "http://localhost:7200/repositories/myrepo"
# default = false
# monitor = false
# tag = "graphdb"
# search_provider = "graphdb"

# Generic SPARQL 1.1 endpoint — no FTS plugin, uses FILTER(CONTAINS(...)) for text search
# [[application.sparqlEndpoints]]
# name = "Generic SPARQL"
# url = "http://localhost:3030/dataset/sparql"
# default = false
# monitor = false
# tag = "generic"
# search_provider = "sparql-query"

# Apache Jena Fuseki endpoint with text:query FTS (requires jena-text module + configured text index)
# [[application.sparqlEndpoints]]
# name = "Fuseki (local)"
# url = "http://localhost:3030/dataset/sparql"
# default = false
# monitor = false
# tag = "fuseki"
# search_provider = "fuseki"

# QLever private triplestore (optional — only add if you run QLever locally)
# See qlever/ and scripts/qlever-start-dev.sh for setup instructions.
#
# Dev (go run on host, QLever as standalone Docker container):
#   url = "http://localhost:7001"
#
# Prod (Docker Compose with --profile qlever):
#   url = "http://qlever:7001"   ← Docker internal DNS on qlever-private network
#
# [[application.sparqlEndpoints]]
# name = "QLever (local)"
# url = "http://qlever:7001"
# default = false
# monitor = true
# tag = "qlever"


# RDF settings
[rdf]
# static prefixes, one per line, enclosed by quotes and terminated by a comma
# use either SPARQL or turtle notation, both are accepted
prefixes = [
  "PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>",
  "PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>",
  "PREFIX owl:    <http://www.w3.org/2002/07/owl#>",
  "PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>",
  "PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>", 
  "PREFIX dcat:   <http://www.w3.org/ns/dcat#>",
  "PREFIX adms:   <http://www.w3.org/ns/adms#>",
  "PREFIX vcard:  <http://www.w3.org/2006/vcard/ns#>",
  "PREFIX schema: <http://schema.org/>",
  "PREFIX void:   <http://rdfs.org/ns/void#>",
  "PREFIX foaf:   <http://xmlns.com/foaf/0.1/>",
  "PREFIX dct:    <http://purl.org/dc/terms/>",
  "PREFIX dc:     <http://purl.org/dc/elements/1.1/>",
  "PREFIX cc:     <http://creativecommons.org/ns#>",
  "PREFIX gtfs:   <http://vocab.gtfs.org/terms#>", 
  "PREFIX rico:   <https://www.ica.org/standards/RiC/ontology#>",
  "PREFIX schch:  <https://schema.ld.admin.ch/>",
  "PREFIX regch:  <https://register.ld.admin.ch/>",
  "PREFIX refch:  <https://reference.data.admin.ch/>",
  "PREFIX euvoc:  <http://publications.europa.eu/ontology/euvoc#>",
  "@prefix vl:       <https://version.link/>",
  "@prefix cube:     <https://cube.link/> .",
  "@prefix meta:     <https://cube.link/meta/> .",
  "@prefix relation: <https://cube.link/relation/> ."
]

# if a resource has several rdf:type this list is used to prioritize the matching templates
type_priority = [
  "https://schema.ld.admin.ch/ZefixOrganisation",
  "http://schema.org/Organization",
  "http://schema.org/DefinedTerm"
]

# Magic properties: a visoto:<key> token in a template query expands to the property
# path below, wrapped in parentheses, with any prefixes it uses declared automatically.
# This spares every template from repeating the same vocabulary alternation.
# Several shipped templates use visoto:description — keep this key defined.
# The key "dispLang" is reserved and cannot be used here.
[rdf.magic_properties]
description = "rdfs:comment|schema:description|dct:description|dc:description"

# Well-known ontologies available for one-click loading in the Upload modal.
# Each entry requires: name (display label), url (fetch source), graph (target named graph URI).
[[ontologies]]
name  = "RDF"
url   = "https://www.w3.org/1999/02/22-rdf-syntax-ns#"
graph = "urn:ontology:w3/rdf-syntax-ns"

[[ontologies]]
name  = "RDFS"
url   = "https://www.w3.org/2000/01/rdf-schema"
graph = "urn:ontology:w3/rdf-schema"

[[ontologies]]
name  = "OWL"
url   = "https://www.w3.org/2002/07/owl#"
graph = "urn:ontology:w3/owl"

[[ontologies]]
name  = "SKOS"
url   = "https://www.w3.org/2009/08/skos-reference/skos.rdf"
graph = "urn:ontology:w3/skos"

[[ontologies]]
name  = "DC"
url   = "http://purl.org/dc/elements/1.1/"
graph = "urn:ontology:dc/elements"

[[ontologies]]
name  = "DCT"
url   = "http://purl.org/dc/terms/"
graph = "urn:ontology:dc/terms"

# MCP server settings
# Note: port is unused when MCP is embedded in the main server (default).
[mcp]
port = 8070

# Logging configuration
[logging]
level = "DEBUG"   # DEBUG, INFO, WARN, ERROR
format = "text"  # json, text
output = "stdout" # stdout, stderr, or file path

# ---------------------------------------------------------------------------
# Harvesting pipeline (cmd/visoto-harvest)
#
# Harvests DCAT catalogues from open data portals, derives dataset structure from
# the actual files, and writes both into a triplestore. Requirements and data
# model: .project/todo/pipelinePlan.md
#
# The web server ignores this block entirely — an absent [pipeline] section, or
# enabled = false, leaves it unaffected. The block is only validated when the
# pipeline is enabled, so a half-written config cannot stop the site from booting.
# ---------------------------------------------------------------------------
# [pipeline]
# enabled = true
#
# # Slug of the [[application.sparqlEndpoints]] entry the pipeline writes into.
# # A slug rather than a URL, so credentials stay defined in one place.
# # Required for loader = "sparql-update"; unused by "bulk-file".
# target_endpoint = "qlever-local"
#
# work_dir = "./pipeline/work"          # blobs and staged N-Quads
# state_db = "./pipeline/state.sqlite"  # job queue, watermarks, run history
#
# workers            = 8
# max_download_bytes = 536870912        # 512 MB; larger distributions are recorded as skipped
# sample_rows        = 200000           # profiling cap; beyond it a structure is marked sampled
# top_k              = 10               # sample values kept per field
#
# # How quads reach the triplestore:
# #   "bulk-file"     stage N-Quads under work_dir for a QLever re-index (default)
# #   "sparql-update" write over the SPARQL protocol, visible immediately
# # Bulk-file is the default because heavy UPDATE volume degrades QLever query
# # performance — see the note in scripts/qlever-start-dev.sh. Use sparql-update
# # for incremental top-ups between re-indexes, not for a full harvest.
# loader = "bulk-file"
# update_batch_quads = 5000
#
# # Standard-vocabulary projections emitted alongside the viso: spine. Each
# # roughly doubles triple count for the structures it covers, so they are
# # individually switchable.
# emit_csvw  = true    # csvw:Table / csvw:Column for tabular distributions
# emit_shacl = true    # sh:NodeShape / sh:property, making structure executable
# emit_void  = true    # void: partitions for RDF distributions
#
# keep_runs = 3        # run-scoped graphs retained per distribution
#
# # Roots every minted IRI. FREEZE THIS BEFORE THE FIRST LOAD: changing it later
# # re-mints every IRI in the store, which is a migration, not a config change.
# base_iri   = "https://visoto.hutzli.org/id/"
# user_agent = "visoto-harvest/1.0 (+https://visoto.hutzli.org)"

# Each source is one catalogue. `type` selects a registered adapter; run
# `visoto-harvest sources` to list the adapters compiled in. Adapters normalize
# whatever the portal speaks into DCAT-AP, so nothing downstream is CKAN- or
# SPARQL-specific.
#
# name       — stable identifier; it reaches graph IRIs and job state, so
#              renaming a source starts it over
# rate_limit — "N/s", "N/m" or "N/h". Not optional in practice: an unpaced
#              worker pool gets the harvester blocked by the portal.
# page_size  — datasets per request

# [[pipeline.sources]]
# name       = "opendata-swiss"
# type       = "ckan"
# url        = "https://ckan.opendata.swiss/api/3/action"
# enabled    = true
# rate_limit = "2/s"
# page_size  = 500
# # Dataset IRIs are minted under this base. Set it explicitly whenever the API
# # host is not the public portal host, so IRIs never depend on where the API
# # happened to be reached.
# dataset_iri_base = "https://opendata.swiss/dataset"

# [[pipeline.sources]]
# name       = "data-europa"
# type       = "dcat-sparql"
# url        = "https://data.europa.eu/sparql"
# enabled    = false
# rate_limit = "1/s"
# page_size  = 500
