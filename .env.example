# Visoto environment variables.
#
# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Consumed by docker-compose.yml (which reads .env automatically),
# scripts/qlever-start-dev.sh, and any ${VAR} reference in visoto.config.

# Write token for the local QLever triplestore. Required for SPARQL UPDATE and
# for Graph Store uploads via the "Upload data" modal (/api/upload).
#
# The same value is used in two places and they must match:
#   - passed to qlever-server as -a (docker-compose.yml / qlever-start-dev.sh)
#   - access_token of the visoto-qlever endpoint in visoto.config
#
# Generate one with:  openssl rand -hex 24
QLEVER_ACCESS_TOKEN=

# API key for the Gemini-backed chat feature. Optional: leave empty (and leave
# gemini_api_key commented out in visoto.config) if you do not want chat.
# Get one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
